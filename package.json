{
  "name": "spec-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A specification written as properties, and a mutation score that measures whether the tests would notice if the function were wrong.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "mutate": "tsx mutation/score.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "fast-check": "3.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.6",
    "typescript": "5.7.2",
    "vite": "^6.4.4",
    "vitest": "^2.1.9"
  }
}
